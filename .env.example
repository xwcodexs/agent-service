# ============================================================
# 环境变量配置模板
# 复制本文件为 .env 并填入你自己的值：  cp .env.example .env
# .env 已被 .gitignore 忽略，绝不要提交真实密钥。
# ============================================================

# -------------------- 应用配置 --------------------
APP_NAME=insurance-agent-service
APP_HOST=127.0.0.1
APP_PORT=8001
APP_DEBUG=true

# -------------------- 数据库配置 --------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=insurance
DB_USER=insurance
DB_PASSWORD=change-me
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5

# -------------------- 模型配置（应用服务）--------------------
DEEPSEEK_API_KEY=your-deepseek-api-key
CHAT_MODEL=deepseek-v4-flash

# -------------------- 日志配置 --------------------
LOGGING_LEVEL=INFO

# -------------------- 教学 notebook 配置 --------------------
# app/notebooks 下的示例使用 DashScope 的 OpenAI 兼容端点
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your-dashscope-api-key
